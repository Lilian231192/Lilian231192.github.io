---
import Icon from '@/components/ui/Icon.astro'
import { cv } from '@/data/cv'
import { section, sectionLinks, site, text } from '@/data/site'

const { email, profiles, name, label, location, url } = cv.basics
const locationText = [location?.city, location?.region, location?.countryCode].filter(Boolean).join(', ')

type IndexGroup = 'sections' | 'cases' | 'skills' | 'links'

interface IndexEntry {
  group: IndexGroup
  label: string
  meta: string
  href: string
  external?: boolean
  search: string
}

/**
 * Flat, serialisable search dataset. `command-search.ts` renders it grouped by
 * `group`, filters on `search` and keeps real anchors in the DOM.
 */
const indexEntries: IndexEntry[] = [
  ...sectionLinks.map(link => ({
    group: 'sections' as const,
    label: link.label,
    meta: `${link.index} · ${link.tagline}`,
    href: `#${link.id}`,
    search: `${link.label} ${link.tagline} ${link.id} plate ${link.index}`,
  })),
  ...(section('projects').enabled
? cv.projects
: []).map((project, projectIndex) => ({
    group: 'cases' as const,
    label: project.name,
    meta: `${text('common.case')} ${String(projectIndex + 1).padStart(2, '0')}`,
    href: `#project-${projectIndex + 1}`,
    search: `${project.name} ${project.description} case file project ${project.isActive === false
? 'archived'
: 'active'}`,
  })),
  ...(section('skills').enabled
? cv.skills
: []).map(skill => ({
    group: 'skills' as const,
    label: skill.name,
    meta: skill.category ?? text('index.skill'),
    href: '#skills',
    search: [
skill.name,
skill.category,
...(skill.keywords ?? []),
'skill',
].join(' '),
  })),
  ...(email
    ? [
{
        group: 'links' as const,
        label: email,
        meta: text('common.email'),
        href: `mailto:${email}`,
        search: `${email} email mail direct line contact`,
      },
]
    : []),
  ...(url
    ? [
{
        group: 'links' as const,
        label: url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
        meta: text('common.website'),
        href: url,
        external: true,
        search: `${url} website site home`,
      },
]
    : []),
  ...profiles.map(profile => ({
    group: 'links' as const,
    label: profile.network,
    meta: `@${profile.username}`,
    href: profile.url,
    external: true,
    search: `${profile.network} ${profile.username} ${profile.url} profile link`,
  })),
]

const indexGroups = ([
'sections',
'cases',
'skills',
'links',
] as const)
  .map(group => ({
group,
entries: indexEntries.filter(entry => entry.group === group),
}))
  .filter(group => group.entries.length > 0)
---
<dialog id="indexDialog" class="index-dialog print-hide" aria-labelledby="index-title">
  <div class="index-dialog__frame">
    <header class="index-dialog__bar">
      <p class="mono">{name} / {label}</p>
      <p class="mono index-dialog__place">{locationText}</p>
      <button class="index-dialog__close" type="button" data-index-close aria-label={text('index.closeLabel')}>
        <span>{text('common.close')}</span>
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div class="index-dialog__find" role="search">
      <label class="index-dialog__find-label mono" for="indexSearch">{text('index.find')}</label>
      <input
        id="indexSearch"
        class="index-dialog__find-input"
        type="search"
        placeholder={text('index.placeholder')}
        autocomplete="off"
        spellcheck="false"
        aria-controls="indexResults"
        data-command-input
      />
      <p class="index-dialog__find-hint mono">
        <kbd>⌘</kbd><kbd>K</kbd>
        <span class="index-dialog__find-hint-text">{text('index.shortcutHint')}</span>
      </p>
    </div>
    <p class="mono index-dialog__find-status" data-command-status aria-live="polite"></p>

    <div class="index-dialog__body">
      <div class="index-dialog__intro">
        <p class="mono index-dialog__eyebrow">{text('index.navigation')} / {String(sectionLinks.length).padStart(2, '0')}</p>
        <h2 id="index-title" class="index-dialog__title">{text('index.title')}</h2>
        <p class="index-dialog__note">
          {text('index.note')}
        </p>
        <p class="mono index-dialog__clock">
          {text('common.localTime')}
          <time data-clock data-time-zone={site.timeZone}>--:--</time>
        </p>
      </div>

      <div class="index-dialog__main">
        <nav class="index-dialog__nav" aria-label={text('index.sectionsLabel')} data-command-nav>
          <ol class="index-dialog__list">
            {
              sectionLinks.map(link => (
                <li>
                  <a class="index-dialog__link" href={`#${link.id}`} data-index-link>
                    <span class="index-dialog__num" aria-hidden="true">{link.index}</span>
                    <span class="index-dialog__label">{link.label}</span>
                    <span class="index-dialog__tag">{link.tagline}</span>
                    <span class="index-dialog__arrow" aria-hidden="true">↘</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="index-dialog__results" id="indexResults" data-command-results hidden>
          {
            indexGroups.map(group => (
              <section class="index-dialog__group" data-command-group={group.group}>
                <h3 class="mono index-dialog__group-title">{text(`index.${group.group}`)}</h3>
                <ul class="index-dialog__hits">
                  {group.entries.map(entry => (
                    <li
                      class="index-dialog__hit"
                      data-command-item
                      data-command-search={entry.search.toLowerCase()}
                    >
                      <a
                        class="index-dialog__hit-link"
                        href={entry.href}
                        target={entry.external ? '_blank' : undefined}
                        rel={entry.external ? 'noopener noreferrer' : undefined}
                        data-command-result
                      >
                        <span class="index-dialog__hit-label">{entry.label}</span>
                        <span class="mono index-dialog__hit-meta">{entry.meta}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
          <p class="index-dialog__empty" data-command-empty hidden>
            {text('index.empty')}
          </p>
        </div>
      </div>

      <aside class="index-dialog__aside">
        {
          email && (
            <div class="index-dialog__block">
              <p class="meta">{text('common.directLine')}</p>
              <a class="index-dialog__email" href={`mailto:${email}`} data-index-link>{email}</a>
            </div>
          )
        }

        {
          profiles.length > 0 && (
            <div class="index-dialog__block">
              <p class="meta">{text('index.elsewhere')}</p>
              <ul class="index-dialog__profiles">
                {profiles.map(profile => (
                  <li>
                    <a href={profile.url} target="_blank" rel="noopener noreferrer">
                      <Icon name={profile.icon} width={14} height={14} aria-hidden="true" />
                      <span>{profile.network}</span>
                      <span class="index-dialog__handle">@{profile.username}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {site.features.print && (
<div class="index-dialog__block">
          <p class="meta">{text('index.print')}</p>
          <div class="index-dialog__print">
            <button type="button" data-print>{text('index.compactPrint')}</button>
            <button type="button" data-print data-print-mode="poster">{text('index.posterPrint')}</button>
          </div>
        </div>
)}

        <div class="index-dialog__block">
          <p class="meta">{text('index.colophon')}</p>
          <p class="index-dialog__colophon">{text('site.tagline')}</p>
        </div>
      </aside>
    </div>

    <footer class="index-dialog__foot">
      <span class="mono">
        <kbd>↑</kbd><kbd>↓</kbd> {text('common.select')} · <kbd>Enter</kbd> {text('common.open')} · <kbd>Esc</kbd> {text('common.close')}
      </span>
      <a
        class="mono index-dialog__top"
        href={section('top').enabled
? '#top'
: '#main'}
        data-index-link
      >{text('common.backToTop')} ↑</a>
    </footer>
  </div>
</dialog>

<script>
import { initClocks } from '@/scripts/clock'
import { initCommandSearch } from '@/scripts/command-search'
import { initIndexDialog } from '@/scripts/index-dialog'

initIndexDialog()
initCommandSearch()
initClocks()
</script>

<style>
  @reference "../globals.css";

  .index-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink-panel);
    color: var(--ink-fg);
    overflow: auto;
  }

  .index-dialog::backdrop {
    background: rgb(4 4 3 / 0.92);
  }

  .index-dialog[open] {
    display: block;
    animation: index-in 0.45s var(--ease-expo);
  }

  .index-dialog__frame {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  .index-dialog__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid color-mix(in oklab, var(--ink-fg) 45%, transparent);
  }

  .index-dialog__bar .mono {
    color: var(--ink-fg-2);
  }

  .index-dialog__place {
    margin-left: auto;
  }

  .index-dialog__close {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.8rem;
    border: 2px solid var(--ink-fg);
    background: transparent;
    color: var(--ink-fg);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .index-dialog__close:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--on-accent);
  }

  .index-dialog__body {
    display: grid;
    grid-template-columns: minmax(13rem, 0.9fr) minmax(20rem, 2.4fr) minmax(13rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    flex: 1;
    padding-block: clamp(2rem, 5vw, 5rem);
  }

  .index-dialog__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .index-dialog__eyebrow {
    color: var(--accent-lit);
  }

  .index-dialog__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.78;
    text-transform: uppercase;
    margin-left: -0.04em;
  }

  .index-dialog__note {
    max-width: 26ch;
    color: var(--ink-fg-2);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .index-dialog__clock {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--ink-fg-2);
  }

  .index-dialog__clock time {
    color: var(--accent-lit);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .index-dialog__find {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.9rem;
    padding-block: 1rem 0.85rem;
    border-bottom: 1px solid color-mix(in oklab, var(--ink-fg) 22%, transparent);
    background: var(--ink-panel);
  }

  .index-dialog__find-label {
    color: var(--ink-fg-3);
  }

  .index-dialog__find-input {
    width: 100%;
    min-width: 0;
    padding: 0.3rem 0;
    border: 0;
    border-bottom: 2px solid color-mix(in oklab, var(--ink-fg) 32%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--ink-fg);
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 1.5vw, 1.2rem);
    letter-spacing: 0.02em;
    appearance: none;
    transition: border-color 0.2s var(--ease-out);
  }

  .index-dialog__find-input::placeholder {
    color: color-mix(in oklab, var(--ink-fg) 55%, transparent);
  }

  .index-dialog__find-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .index-dialog__find-input:focus-visible {
    border-color: var(--accent-lit);
    outline: 2px solid var(--accent-lit);
    outline-offset: 3px;
  }

  .index-dialog__find-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-fg-3);
  }

  .index-dialog__find-hint kbd {
    display: inline-block;
    padding: 0.1rem 0.35rem;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.4;
  }

  .index-dialog__find-status {
    color: var(--ink-fg-2);
    overflow-wrap: anywhere;
  }

  .index-dialog__find-status:not(:empty) {
    padding-block: 0.7rem;
  }

  .index-dialog__list {
    border-top: 2px solid color-mix(in oklab, var(--ink-fg) 45%, transparent);
  }

  .index-dialog__link {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto 1.5rem;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0.35rem;
    border-bottom: 1px solid color-mix(in oklab, var(--ink-fg) 24%, transparent);
    transition:
      background-color 0.22s var(--ease-out),
      color 0.22s var(--ease-out),
      padding-left 0.22s var(--ease-out);
  }

  .index-dialog__link:hover,
  .index-dialog__link:focus-visible {
    background: var(--accent);
    color: var(--on-accent);
    padding-left: 0.9rem;
  }

  .index-dialog__num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    opacity: 0.7;
  }

  .index-dialog__label {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 4.5rem);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .index-dialog__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .index-dialog__arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .index-dialog__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .index-dialog__results {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .index-dialog__empty {
    max-width: 36ch;
    color: var(--ink-fg-2);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .index-dialog__group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .index-dialog__group-title {
    color: var(--accent-lit);
  }

  .index-dialog__hits {
    border-top: 2px solid color-mix(in oklab, var(--ink-fg) 45%, transparent);
  }

  .index-dialog__hit-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0.35rem;
    border-bottom: 1px solid color-mix(in oklab, var(--ink-fg) 24%, transparent);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      padding-left 0.2s var(--ease-out);
  }

  .index-dialog__hit-link:hover,
  .index-dialog__hit-link:focus-visible,
  .index-dialog__hit.is-active .index-dialog__hit-link {
    background: var(--accent);
    color: var(--on-accent);
    padding-left: 0.8rem;
  }

  .index-dialog__hit-label {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .index-dialog__hit-meta {
    color: var(--ink-fg-3);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-align: right;
    text-transform: none;
  }

  .index-dialog__hit-link:hover .index-dialog__hit-meta,
  .index-dialog__hit-link:focus-visible .index-dialog__hit-meta,
  .index-dialog__hit.is-active .index-dialog__hit-meta {
    color: var(--on-accent);
  }

  .index-dialog__aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .index-dialog__aside .meta {
    color: var(--ink-fg-3);
  }

  .index-dialog__block {
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in oklab, var(--ink-fg) 28%, transparent);
  }

  .index-dialog__email {
    display: inline-block;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border-bottom: 1px solid currentColor;
    overflow-wrap: anywhere;
  }

  .index-dialog__email:hover {
    color: var(--accent-lit);
  }

  .index-dialog__profiles {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .index-dialog__profiles a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .index-dialog__profiles a:hover {
    color: var(--accent-lit);
  }

  .index-dialog__handle {
    margin-left: auto;
    color: var(--ink-fg-3);
    text-transform: none;
    letter-spacing: 0;
  }

  .index-dialog__colophon {
    margin-top: 0.35rem;
    color: var(--ink-fg-2);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .index-dialog__print {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .index-dialog__print button {
    min-height: 2rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--ink-fg) 35%, transparent);
    background: transparent;
    color: var(--ink-fg-2);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .index-dialog__print button:hover {
    border-color: var(--accent-lit);
    color: var(--accent-lit);
  }

  .index-dialog__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding-top: 0.9rem;
    border-top: 2px solid color-mix(in oklab, var(--ink-fg) 45%, transparent);
    color: var(--ink-fg-3);
  }

  .index-dialog__foot kbd {
    display: inline-block;
    padding: 0.1rem 0.35rem;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .index-dialog__top:hover {
    color: var(--accent-lit);
  }

  @keyframes index-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }

    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 74rem) {
    .index-dialog__body {
      grid-template-columns: minmax(11rem, 0.8fr) minmax(18rem, 2fr);
    }

    .index-dialog__aside {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .index-dialog__bar .mono:first-child {
      max-width: 62%;
      overflow: hidden;
      font-size: 0.5625rem;
      letter-spacing: 0.1em;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .index-dialog__place {
      display: none;
    }

    .index-dialog__close span[aria-hidden="true"] {
      display: none;
    }

    .index-dialog__find {
      column-gap: 0.65rem;
      padding-block: 0.8rem 0.7rem;
    }

    .index-dialog__find-hint-text {
      display: none;
    }

    .index-dialog__hit-link {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }

    .index-dialog__hit-meta {
      text-align: left;
    }

    .index-dialog__body {
      grid-template-columns: 1fr;
      padding-block: 1.5rem;
      gap: 1.5rem;
    }

    .index-dialog__title {
      font-size: clamp(3.5rem, 18vw, 5rem);
    }

    .index-dialog__clock {
      margin-top: 0;
    }

    .index-dialog__link {
      grid-template-columns: 2.25rem minmax(0, 1fr) 1rem;
      gap: 0.65rem;
    }

    .index-dialog__tag {
      display: none;
    }

    .index-dialog__label {
      font-size: clamp(1.8rem, 9vw, 2.6rem);
    }

    .index-dialog__aside {
      grid-template-columns: 1fr;
    }

    .index-dialog__foot {
      font-size: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-dialog[open] {
      animation: none;
    }
  }
</style>
