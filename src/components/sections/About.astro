---
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'

const { about, summary } = cv.basics
const personalInfo = about?.personalInfo ?? []
const traits = about?.traits ?? []
const highlights = [
  ...(about?.highlights ?? []),
  ...cv.awards.map(award => ({
text: [
award.title,
award.awarder,
award.date,
award.summary,
].filter(Boolean).join(' / '),
})),
]
const quote = about?.quote
const languages = cv.languages ?? []
const interests = cv.interests ?? []
const references = cv.references ?? []

const meta = [
  `${String(personalInfo.length).padStart(2, '0')} ${text('about.facts')}`,
  `${String(traits.length).padStart(2, '0')} ${text('about.traits')}`,
  `${String(highlights.length).padStart(2, '0')} ${text('common.highlights')}`,
].join(' · ')
---
<Section id="about" meta={meta}>
  <div class="about__top">
    <div class="about__intro" data-scroll>
      <p class="kicker">{text('about.intro')}</p>
      <p class="about__manifesto" data-ink-text>
        {text('about.manifestoFirst').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}<br />
        <em>{text('about.manifestoMiddle').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}</em><br />
        {text('about.manifestoLast').split(/\s+/).map(word => <><span data-ink-word>{word}</span>{' '}</>)}
      </p>
      {summary && <p class="about__summary">{summary}</p>}
      <p class="about__note mono">
        {text('about.note')}
      </p>
    </div>

    <dl class="about__facts">
      {
        personalInfo.map((item, i) => (
          <div class="about__fact" data-scroll style={`--i: ${i}`}>
            <dt>
              <span class="about__fact-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__fact-label mono">{item.label}</span>
            </dt>
            <dd class="about__fact-value display">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  {
    quote && (
      <figure class="about__quote" data-scroll="left">
        <span class="about__quote-mark display" aria-hidden="true">“</span>
        <blockquote class="about__quote-text">{quote.text}</blockquote>
        <figcaption class="about__quote-foot">
          <span class="stamp stamp--solid">{text('about.principle')}</span>
          <ul class="about__values" aria-label={text('about.values')}>
            {quote.values.map((value, i) => (
              <li>
                <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{value.label}</span>
              </li>
            ))}
          </ul>
        </figcaption>
        <span class="about__quote-grid" aria-hidden="true"></span>
      </figure>
    )
  }

  <div class="about__lower">
    <section class="about__traits" aria-labelledby="about-traits-title" data-scroll>
      <header class="about__block-head">
        <h3 id="about-traits-title" class="about__block-title display">{text('about.traits')}</h3>
        <span class="mono">{String(traits.length).padStart(2, '0')} / {text('about.method')}</span>
      </header>
      <ol class="about__trait-list">
        {
          traits.map((trait, i) => (
            <li class:list={['about__trait', i % 2 === 1 && 'about__trait--offset']}>
              <span class="about__trait-index display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__trait-text">{trait.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about__record" aria-labelledby="about-record-title" data-scroll>
      <header class="about__block-head">
        <h3 id="about-record-title" class="about__block-title display">{text('about.record')}</h3>
        <span class="mono">{text('about.signals')}</span>
      </header>
      <ol class="about__record-list">
        {
          highlights.map((highlight, i) => (
            <li>
              <span class="about__record-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="about__record-text">{highlight.text}</span>
              <span class="about__record-arrow" aria-hidden="true">↗</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <div class="about__appendix" data-scroll>
    <div class="about__appendix-block">
      <h3 class="meta">{text('about.languages')}</h3>
      <ul class="about__compact-list">
        {languages.map(language => (
          <li>
            <span class="display about__compact-name">{language.language}</span>
            <span class="mono about__compact-meta">{language.fluency}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="about__appendix-block">
      <h3 class="meta">{text('about.interests')}</h3>
      <ul class="about__compact-list">
        {interests.map(interest => (
          <li>
            <span class="display about__compact-name">{interest.name}</span>
            <span class="mono about__compact-meta">{interest.keywords?.join(' / ')}</span>
          </li>
        ))}
      </ul>
    </div>

    {references.length > 0 && (
<div class="about__appendix-block about__appendix-block--note">
      <h3 class="meta">{text('about.references')}</h3>
      {references.map(reference => <blockquote class="about__reference"><p>{reference.reference}</p><footer>{reference.name}</footer></blockquote>)}
    </div>
)}
    {cv.publications.length > 0 && (
<div class="about__appendix-block">
      <h3 class="meta">{text('about.publications')}</h3>
      <ul class="about__compact-list">
        {cv.publications.map(publication => (
<li>
          {publication.url
? <a class="link-line" href={publication.url} target="_blank" rel="noopener noreferrer">{publication.name}</a>
: <span>{publication.name}</span>}
          <span class="mono about__compact-meta">{[publication.publisher, publication.releaseDate].filter(Boolean).join(' / ')}</span>
          {publication.summary && <p>{publication.summary}</p>}
        </li>
))}
      </ul>
    </div>
)}
  </div>
</Section>

<style>
  @reference "../../globals.css";

  @layer components {
    .about__top {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: start;
      }

      .about__intro {
        grid-column: 1 / span 7;
      }

      .about__intro .kicker {
        margin-bottom: 1.2rem;
      }

      .about__summary {
        max-width: 22ch;
        margin-bottom: 1.5rem;
        font-size: clamp(1.8rem, 3.6vw, 3.8rem);
        line-height: 0.98;
        letter-spacing: -0.02em;
        text-transform: none;
      }

      .about__summary::first-line {
        color: var(--accent-text);
      }

      .about__note {
        max-width: 34ch;
        color: var(--fg-3);
      }

      .about__facts {
        grid-column: 8 / -1;
        border-top: 4px solid var(--fg);
      }

      .about__fact {
        display: grid;
        grid-template-columns: minmax(5.5rem, 0.7fr) minmax(0, 1.3fr);
        align-items: baseline;
        gap: 1rem;
        padding-block: 0.9rem;
        border-bottom: 1px solid var(--line);
      }

      .about__fact dt {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
      }

      .about__fact-index {
        color: var(--accent-text);
      }

      .about__fact-label {
        color: var(--fg-2);
      }

      .about__fact-value {
        margin: 0;
        font-size: clamp(1.35rem, 2.2vw, 2rem);
        line-height: 1;
        text-align: right;
        text-transform: none;
        font-family: var(--font-sans);
        font-weight: 600;
      }

      .about__quote {
        position: relative;
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        margin-block: clamp(3rem, 6vw, 6rem);
        padding: clamp(1.5rem, 4vw, 4rem);
        background: var(--ink-panel);
        color: var(--ink-fg);
        overflow: hidden;
      }

      .about__quote::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 32%;
        height: 0.9rem;
        background: var(--accent);
      }

      .about__quote-mark {
        position: absolute;
        top: -0.22em;
        right: 0.08em;
        font-size: clamp(8rem, 20vw, 20rem);
        line-height: 1;
        color: var(--accent);
        opacity: 0.8;
        pointer-events: none;
      }

      .about__quote-text {
        position: relative;
        z-index: 1;
        max-width: 27ch;
        margin: 0;
        font-size: clamp(2rem, 4.6vw, 4.8rem);
        line-height: 0.94;
        text-transform: none;
      }

      .about__quote-foot {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 2rem;
        padding-top: 1.2rem;
        border-top: 1px solid color-mix(in oklab, var(--ink-fg) 30%, transparent);
      }

      .about__values {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.4rem;
      }

      .about__values li {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-fg-2);
      }

      .about__values li span:first-child {
        color: var(--accent-lit);
      }

      .about__quote-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(90deg, color-mix(in oklab, var(--ink-fg) 8%, transparent) 1px, transparent 1px),
          linear-gradient(0deg, color-mix(in oklab, var(--ink-fg) 8%, transparent) 1px, transparent 1px);
        background-size: 4rem 100%, 100% 4rem;
        mask-image: linear-gradient(90deg, transparent, black 60%);
        pointer-events: none;
      }

      .about__lower {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }

      .about__traits {
        grid-column: 1 / span 7;
      }

      .about__record {
        grid-column: 8 / -1;
      }

      .about__block-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding-bottom: 0.8rem;
        border-bottom: 4px solid var(--fg);
        margin-bottom: 1.2rem;
      }

      .about__block-title {
        font-size: clamp(1.8rem, 3.6vw, 3rem);
      }

      .about__block-head .mono {
        color: var(--fg-3);
      }

      .about__trait-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
      }

      .about__trait {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 10rem;
        padding: 1.1rem;
        background: var(--bg);
      }

      .about__trait--offset {
        background: var(--panel);
      }

      .about__trait-index {
        font-size: 2.2rem;
        line-height: 0.8;
        color: transparent;
        -webkit-text-stroke: 1px var(--fg);
      }

      .about__trait-text {
        margin-top: auto;
        max-width: 18ch;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.3;
        text-wrap: balance;
      }

      .about__record-list {
        border-top: 1px solid var(--line);
      }

      .about__record-list li {
        display: grid;
        grid-template-columns: 2rem minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 0.8rem;
        padding-block: 0.8rem;
        border-bottom: 1px solid var(--line);
      }

      .about__record-index {
        color: var(--accent-text);
      }

      .about__record-text {
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .about__record-arrow {
        font-family: var(--font-mono);
        color: var(--accent-text);
        transition: transform 0.2s var(--ease-out);
      }

      .about__record-list li:hover .about__record-arrow {
        transform: translate(0.2rem, -0.2rem);
      }

      .about__appendix {
        display: grid;
        grid-template-columns: 1fr 1fr 0.8fr;
        gap: var(--grid-gap);
        margin-top: clamp(2.5rem, 5vw, 5rem);
        padding-top: 1.2rem;
        border-top: 4px solid var(--fg);
      }

      .about__appendix-block {
        min-width: 0;
      }

      .about__appendix-block .meta {
        margin-bottom: 0.75rem;
      }

      .about__compact-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .about__compact-list li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--line);
      }

      .about__compact-name {
        font-size: clamp(1.2rem, 2vw, 1.7rem);
        line-height: 1;
      }

      .about__compact-meta {
        color: var(--fg-3);
        text-align: right;
      }

      .about__reference {
        max-width: 24ch;
        margin-bottom: 0.7rem;
        color: var(--fg-2);
        font-size: var(--fs-small);
      }

      .about__appendix-block--note .arrow-link {
        color: var(--accent-text);
      }

      @media (max-width: 63.99rem) {
        .about__intro,
        .about__facts,
        .about__traits,
        .about__record {
          grid-column: 1 / -1;
        }

        .about__facts {
          margin-top: 1rem;
        }

        .about__appendix {
          grid-template-columns: 1fr 1fr;
        }

        .about__appendix-block--note {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 47.99rem) {
        .about__summary {
          font-size: clamp(1.6rem, 8vw, 2.4rem);
        }

        .about__fact {
          grid-template-columns: 1fr auto;
        }

        .about__fact-value {
          font-size: 1.1rem;
          text-align: right;
        }

        .about__trait-list {
          grid-template-columns: 1fr;
        }

        .about__trait {
          min-height: 7rem;
        }

        .about__quote {
          padding: 1.25rem;
        }

        .about__quote-mark {
          font-size: 9rem;
        }

        .about__quote-text {
          font-size: clamp(1.7rem, 8vw, 2.6rem);
        }

        .about__appendix {
          grid-template-columns: 1fr;
        }

        .about__record-list li {
          grid-template-columns: 1.5rem minmax(0, 1fr) auto;
          gap: 0.5rem;
        }
      }
  }
</style>
