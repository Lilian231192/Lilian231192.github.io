---
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { text } from '@/data/site'
import { formatDateRange, getYear } from '@/utils/date'

const { education, certificates } = cv
const meta = [
  `${String(education.length).padStart(2, '0')} ${text('education.schools')}`,
  `${String(certificates.length).padStart(2, '0')} ${text('education.certificates')}`,
].join(' · ')
const firstYear = [...education]
  .map(item => getYear(item.startDate))
  .filter((year): year is string => Boolean(year))
  .sort()[0]
const lastYear = education.some(item => !item.endDate)
  ? text('common.present')
  : education.map(item => getYear(item.endDate)).filter(Boolean).sort().at(-1)
---
<Section id="education" meta={meta}>
  <div class="education">
    <div class="education__main">
      <header class="education__head" data-scroll>
        <div>
          <p class="kicker">{text('education.intro')}</p>
          <h3 class="education__statement display">{text('education.statementFirst')}<br />{text('education.statementLast')}</h3>
        </div>
        {firstYear && <span class="education__span mono">{firstYear} → {lastYear}</span>}
      </header>

      <ol class="education__list">
        {
          education.map((item, index) => {
            const isCurrent = !item.endDate
            return (
              <li class="school" data-scroll>
                <div class="school__year display" aria-hidden="true">{getYear(item.startDate) ?? '—'}</div>
                <div class="school__body">
                  <div class="school__top">
                    <span class="mono school__index">{String(index + 1).padStart(2, '0')}</span>
                    {isCurrent
                      ? (
                          <span class="stamp stamp--solid">
                            <span class="status-dot" aria-hidden="true" />
                            {text('common.current')}
                          </span>
                        )
                      : <span class="mono school__done">{text('common.completed')}</span>}
                  </div>
                  <h4 class="school__name display">
                    {item.url
                      ? <a class="link-line" href={item.url} target="_blank" rel="noopener noreferrer">{item.institution}</a>
                      : item.institution}
                  </h4>
                  <p class="school__meta">
                    <span>{item.studyType}</span>
                    <span aria-hidden="true"> / </span>
                    <span>{item.area}</span>
                  </p>
                  <p class="mono school__dates">{formatDateRange(item.startDate, item.endDate, text('common.now'))}</p>
                  {item.score && <p class="school__meta"><span class="meta">{text('education.score')}</span> {item.score}</p>}
                  {item.courses?.length && <p class="school__meta"><span class="meta">{text('education.courses')}</span> {item.courses.join(' / ')}</p>}
                </div>
              </li>
            )
          })
        }
      </ol>

      <p class="education__note mono" data-scroll>
        {text('education.note')}
      </p>
    </div>

    <aside class="education__aside" aria-label={text('education.certification')}>
      {
        certificates.length > 0 && (
          <div class="certs" data-scroll="right">
            <header class="certs__head">
              <span class="kicker">{text('education.certified')}</span>
              <span class="mono">{String(certificates.length).padStart(2, '0')} {text('education.records')}</span>
            </header>

            {certificates.map((certificate, index) => (
              <article class="cert">
                <div class="cert__seal" aria-hidden="true">
                  <svg viewBox="0 0 160 160" role="presentation">
                    <defs>
                      <path id={`cert-ring-${index}`} d="M80,80 m-61,0 a61,61 0 1,1 122,0 a61,61 0 1,1 -122,0" />
                    </defs>
                    <circle cx="80" cy="80" r="72" fill="none" stroke="currentColor" stroke-width="1" />
                    <circle cx="80" cy="80" r="52" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4" />
                    <text>
                      <textPath href={`#cert-ring-${index}`} startOffset="0">
                        {`${certificate.issuer.toUpperCase()} • ${text('education.certified').toUpperCase()} • ${getYear(certificate.date) ?? ''} • `}
                      </textPath>
                    </text>
                    <text x="80" y="86" text-anchor="middle" class="cert__seal-mark">{certificate.name.split(' ')[0]}</text>
                  </svg>
                </div>

                <div class="cert__body">
                  <span class="mono cert__label">{text('education.certificate')} {String(index + 1).padStart(2, '0')}</span>
                  <h4 id={`education-cert-title-${index}`} class="cert__name display">{certificate.name}</h4>
                  <dl class="cert__facts">
                    <div>
                      <dt class="meta">{text('education.issuer')}</dt>
                      <dd>{certificate.issuer}</dd>
                    </div>
                    <div>
                      <dt class="meta">{text('education.issued')}</dt>
                      <dd>{certificate.date.slice(0, 7).replace('-', '.')}</dd>
                    </div>
                  </dl>
                  {certificate.url && (
                    <a class="arrow-link cert__link" href={certificate.url} target="_blank" rel="noopener noreferrer">
                      <span>{text('education.verify')}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }

      <div class="education__aside-note" data-scroll="right">
        <span class="mono">{text('education.asideTitle')}</span>
        <p>
          {text('education.aside')}
        </p>
      </div>
    </aside>
  </div>
</Section>

<style>
  @reference "../../globals.css";

  @layer components {
    .education {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 1fr);
        gap: clamp(2rem, 5vw, 5rem);
        align-items: start;
      }

      .education__head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem 2rem;
        padding-bottom: 1.2rem;
        border-bottom: 4px solid var(--fg);
        margin-bottom: 0.5rem;
      }

      .education__statement {
        margin-top: 0.7rem;
        font-size: clamp(2rem, 4.4vw, 4.2rem);
        line-height: 0.9;
      }

      .education__span {
        color: var(--accent-text);
      }

      .education__list {
        border-top: 1px solid var(--line);
      }

      .school {
        display: grid;
        grid-template-columns: minmax(6rem, 0.8fr) minmax(0, 2fr);
        gap: 1.5rem;
        padding-block: clamp(1.5rem, 3vw, 2.5rem);
        border-bottom: 1px solid var(--line);
      }

      .school__year {
        font-size: clamp(3rem, 6vw, 6rem);
        line-height: 0.75;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--fg);
      }

      .school__top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-bottom: 0.7rem;
      }

      .school__index {
        color: var(--accent-text);
      }

      .school__done {
        color: var(--fg-3);
      }

      .school__name {
        max-width: 22ch;
        margin-bottom: 0.45rem;
        font-size: clamp(1.6rem, 3vw, 2.6rem);
        line-height: 0.95;
      }

      .school__meta {
        color: var(--fg-2);
        font-size: 0.95rem;
      }

      .school__dates {
        margin-top: 0.35rem;
        color: var(--fg-3);
      }

      .education__note {
        margin-top: 1.2rem;
        padding-left: 1rem;
        border-left: 3px solid var(--accent);
        color: var(--fg-3);
      }

      .certs {
        background: var(--ink-panel);
        color: var(--ink-fg);
        padding: clamp(1.2rem, 2.5vw, 2rem);
        border: 2px solid var(--fg);
      }

      .certs__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid color-mix(in oklab, var(--ink-fg) 30%, transparent);
        margin-bottom: 1.25rem;
      }

      .certs__head .mono {
        color: var(--ink-fg-3);
      }

      .cert {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .cert__seal {
        width: clamp(6rem, 10vw, 8.5rem);
        height: clamp(6rem, 10vw, 8.5rem);
        color: var(--accent-lit);
        transform: rotate(-9deg);
      }

      .cert__seal svg {
        width: 100%;
        height: 100%;
        overflow: visible;
      }

      .cert__seal text {
        fill: currentColor;
        font-family: var(--font-mono);
        font-size: 7.5px;
        font-weight: 600;
        letter-spacing: 0.13em;
      }

      .cert__seal :global(.cert__seal-mark) {
        font-family: var(--font-display);
        font-size: 28px;
        letter-spacing: 0.04em;
      }

      .cert__label {
        color: var(--accent-lit);
      }

      .cert__name {
        margin-top: 0.5rem;
        font-size: clamp(1.55rem, 2.5vw, 2.2rem);
        line-height: 0.95;
        text-transform: none;
      }

      .cert__facts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-block: 1.2rem;
        padding-top: 0.8rem;
        border-top: 1px solid color-mix(in oklab, var(--ink-fg) 25%, transparent);
      }

      .cert__facts .meta {
        color: var(--ink-fg-3);
        margin-bottom: 0.2rem;
      }

      .cert__facts dd {
        margin: 0;
        font-size: 0.9rem;
      }

      .cert__link {
        color: var(--accent-lit);
        align-self: flex-start;
      }

      .education__aside-note {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 2px solid var(--fg);
      }

      .education__aside-note .mono {
        color: var(--accent-text);
      }

      .education__aside-note p {
        margin-top: 0.5rem;
        color: var(--fg-2);
        font-size: var(--fs-small);
        line-height: 1.55;
      }

      @media (max-width: 63.99rem) {
        .education {
          grid-template-columns: 1fr;
        }

        .education__aside {
          display: grid;
          grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
          gap: var(--grid-gap);
          align-items: start;
        }

        .education__aside-note {
          margin-top: 0;
        }
      }

      @media (max-width: 47.99rem) {
        .school {
          grid-template-columns: 1fr;
          gap: 0.8rem;
        }

        .school__year {
          font-size: 3.4rem;
        }

        .school__name {
          font-size: clamp(1.5rem, 7vw, 2rem);
        }

        .education__span {
          display: none;
        }

        .education__aside {
          grid-template-columns: 1fr;
        }
      }
  }
</style>
