---
import { Image } from 'astro:assets'
import Section from '@/components/Section.astro'
import { cv } from '@/data/cv'
import { asset, text } from '@/data/site'

const gallery = cv.images
const frames = gallery?.list ?? []
const ratios = ['16 / 10', '4 / 5', '1 / 1', '3 / 2'] as const

// Four prints only: the board is a pinned contact sheet, not a second gallery.
const placements = [
  {
x: '4%',
y: '5%',
w: '31%',
smX: '2%',
smY: '3%',
smW: '46%',
},
  {
x: '40%',
y: '3%',
w: '24%',
smX: '50%',
smY: '5%',
smW: '46%',
},
  {
x: '10%',
y: '44%',
w: '24%',
smX: '3%',
smY: '36%',
smW: '44%',
},
  {
x: '54%',
y: '52%',
w: '27%',
smX: '52%',
smY: '58%',
smW: '44%',
},
] as const
const rotations = [
'-3.2deg',
'2.6deg',
'1.4deg',
'-2.1deg',
] as const
const prints = frames.slice(0, placements.length)
---
{
  frames.length > 0
? (
    <Section
      id="gallery"
      meta={`${String(frames.length).padStart(2, '0')} ${text('gallery.frames')} · ${text('cursor.drag')}`}
    >
      <div class="gallery" data-strip data-gallery>
        <div class="gallery__head" data-scroll>
          <div>
            <p class="kicker">{text('gallery.intro')}</p>
            <p class="gallery__statement">{text('gallery.statementFirst')} <em>{text('gallery.statementLast')}</em></p>
            {gallery?.intro && <p class="gallery__intro">{gallery.intro}</p>}
          </div>
          <div class="gallery__controls">
            <div class="gallery__modes" role="group" aria-label={text('gallery.viewLabel')}>
              <button
                class="gallery__mode"
                type="button"
                data-gallery-mode="board"
                aria-pressed="true"
                aria-controls="gallery-board"
              >
                {text('gallery.board')}
              </button>
              <button
                class="gallery__mode"
                type="button"
                data-gallery-mode="strip"
                aria-pressed="false"
                aria-controls="gallery-strip"
              >
                {text('gallery.strip')}
              </button>
            </div>
            <div class="gallery__meta" data-strip-tools>
              <p class="gallery__counter mono" aria-live="polite">
                <span data-strip-current>01</span>
                <span aria-hidden="true"> / </span>
                <span data-strip-total>{String(frames.length).padStart(2, '0')}</span>
              </p>
              <div class="gallery__buttons">
                <button class="gallery__button" type="button" data-strip-prev aria-label={text('gallery.previous')}>
                  <span aria-hidden="true">←</span>
                </button>
                <button class="gallery__button" type="button" data-strip-next aria-label={text('gallery.next')}>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div
          class="gallery__panel gallery__panel--board"
          id="gallery-board"
          data-gallery-mode-panel="board"
          role="group"
          aria-label={text('gallery.boardLabel')}
        >
          <div class="board" data-board>
            <span class="board__word" aria-hidden="true">{text('gallery.boardFirst')}<br />{text('gallery.boardLast')}</span>
            <span class="board__reg board__reg--tl" aria-hidden="true" />
            <span class="board__reg board__reg--tr" aria-hidden="true" />
            <span class="board__reg board__reg--bl" aria-hidden="true" />
            <span class="board__reg board__reg--br" aria-hidden="true" />

            {prints.map((frame, index) => {
              const number = String(index + 1).padStart(2, '0')
              const caption = frame.desc ?? frame.alt ?? ''
              const ratio = ratios[index % ratios.length] ?? ratios[0]
              const spot = placements[index] ?? placements[0]
              const rotation = rotations[index % rotations.length] ?? rotations[0]

              return (
                <figure
                  class="print"
                  data-board-print
                  style={`--x: ${spot.x}; --y: ${spot.y}; --w: ${spot.w}; --x-sm: ${spot.smX}; --y-sm: ${spot.smY}; --w-sm: ${spot.smW}; --rot: ${rotation}; --print-ratio: ${ratio}`}
                >
                  <span class="print__tape" aria-hidden="true" />
                  <a
                    class="print__link"
                    href={asset(frame.image)}
                    data-lightbox="gallery"
                    data-caption={caption}
                    data-cursor={text('cursor.drag')}
                    draggable="false"
                  >
                    <Image
                      src={asset(frame.image)}
                      alt={frame.alt ?? caption}
                      width={1400}
                      height={1050}
                      format="webp"
                      class="print__image"
                      loading="lazy"
                    />
                    <span class="shot__number display" aria-hidden="true">{number}</span>
                    <span class="sr-only"> — {text('common.viewImage')}</span>
                  </a>
                  <figcaption class="print__caption">
                    <span class="mono print__no" aria-hidden="true">{number}</span>
                    <span class="print__caption-text">{caption}</span>
                  </figcaption>
                </figure>
              )
            })}
          </div>

          <div class="board__foot">
            <p class="mono board__hint">{text('gallery.boardHint')}</p>
            <button class="gallery__reset" type="button" data-board-reset>{text('gallery.reset')}</button>
            <p class="sr-only" role="status" data-board-status />
          </div>
        </div>

        <div class="gallery__panel gallery__panel--strip" id="gallery-strip" data-gallery-mode-panel="strip">
          <div
            class="gallery__scroller"
            tabindex="0"
            role="region"
            aria-label={text('gallery.stripLabel')}
            data-cursor={text('cursor.drag')}
          >
            <ol class="gallery__track">
              {frames.map((frame, index) => {
                const number = String(index + 1).padStart(2, '0')
                const caption = frame.desc ?? frame.alt ?? ''
                const ratio = ratios[index % ratios.length] ?? ratios[0]

                return (
                  <li
                    class:list={['shot', index % 2 === 1 && 'shot--offset']}
                    style={`--shot-ratio: ${ratio}; --shot-i: ${index}`}
                    data-strip-frame
                  >
                    <figure class="shot__figure">
                      <a
                        class="shot__link"
                        href={asset(frame.image)}
                        data-lightbox="gallery"
                        data-caption={caption}
                        data-cursor={text('cursor.view')}
                      >
                        <Image
                          src={asset(frame.image)}
                          alt={frame.alt ?? caption}
                          width={1400}
                          height={1050}
                          format="webp"
                          class="shot__image"
                          loading="lazy"
                        />
                        <span class="shot__number display" aria-hidden="true">{number}</span>
                        <span class="shot__hint mono" aria-hidden="true">{text('gallery.enlarge')} ↗</span>
                        <span class="shot__corner" aria-hidden="true" />
                        <span class="sr-only"> — {text('common.viewImage')}</span>
                      </a>
                      <figcaption class="shot__caption">
                        <span class="mono shot__caption-no" aria-hidden="true">{number}</span>
                        <span class="shot__caption-text">{caption}</span>
                      </figcaption>
                    </figure>
                  </li>
                )
              })}
            </ol>
          </div>

          <div class="gallery__foot">
            <div class="gallery__progress" aria-hidden="true">
              <span data-strip-progress></span>
            </div>
            <p class="mono gallery__hint">{text('gallery.stripHint')}</p>
          </div>
        </div>
      </div>
    </Section>
  )
: (
    <Section id="gallery" meta={`00 ${text('gallery.frames')}`}>
      <p class="gallery__intro">{text('gallery.empty')}</p>
    </Section>
  )
}

<script>
  import { initPhotoBoard } from '@/scripts/photo-board'
  import { initStrips } from '@/scripts/strip'

  initStrips()
  initPhotoBoard()
</script>

<style>
  @reference "../../globals.css";

  @layer components {
    .gallery__head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem 3rem;
        padding-bottom: 1.2rem;
        border-bottom: 4px solid var(--fg);
        margin-bottom: 2rem;
      }

      .gallery__intro {
        max-width: 32ch;
        margin-top: 0.8rem;
        font-size: clamp(1.6rem, 3vw, 2.8rem);
        line-height: 1;
        text-transform: none;
      }

      .gallery__controls {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.9rem;
      }

      .gallery__modes {
        display: inline-flex;
        border: 2px solid var(--fg);
      }

      .gallery__mode {
        padding: 0.55rem 0.85rem;
        border: 0;
        background: transparent;
        color: var(--fg);
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: 0.14em;
        line-height: 1;
        text-transform: uppercase;
        transition:
          background-color 0.2s var(--ease-out),
          color 0.2s var(--ease-out);
      }

      .gallery__mode + .gallery__mode {
        border-left: 2px solid var(--fg);
      }

      .gallery__mode:hover {
        background: var(--line-soft);
      }

      .gallery__mode[aria-pressed="true"],
      .gallery__mode[aria-pressed="true"]:hover {
        background: var(--fg);
        color: var(--bg);
      }

      .gallery__meta {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .gallery__counter {
        display: inline-flex;
        align-items: baseline;
        gap: 0.25rem;
        font-size: 1.4rem;
        color: var(--fg);
      }

      .gallery__counter span:last-child {
        color: var(--fg-3);
        font-size: 0.8rem;
      }

      .gallery__buttons {
        display: flex;
        gap: 0.35rem;
      }

      .gallery__button {
        display: inline-grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: 2px solid var(--fg);
        background: transparent;
        color: var(--fg);
        font-size: 1.1rem;
        transition:
          background-color 0.2s var(--ease-out),
          color 0.2s var(--ease-out);
      }

      .gallery__button:hover {
        background: var(--fg);
        color: var(--bg);
      }

      /* The script marks the active mode; until it runs, desktop shows the board
         and every smaller viewport keeps the original horizontal strip. */
      .gallery__panel--strip {
        display: block;
      }

      .gallery__panel--board {
        display: none;
      }

      .gallery[data-gallery-view="board"] .gallery__panel--board {
        display: block;
      }

      @media (min-width: 64rem) {
        .gallery:not([data-gallery-view]) .gallery__panel--board {
          display: block;
        }

        .gallery:not([data-gallery-view]) .gallery__panel--strip {
          display: none;
        }

        .gallery:not([data-gallery-view]) .gallery__meta {
          display: none;
        }
      }

      .board {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: 3px solid var(--fg);
        background-color: var(--panel);
        background-image:
          linear-gradient(90deg, var(--line-soft) 1px, transparent 1px),
          linear-gradient(0deg, var(--line-soft) 1px, transparent 1px);
        background-size: 3.5rem 3.5rem;
        box-shadow: 9px 9px 0 var(--accent);
        touch-action: pan-y pinch-zoom;
      }

      .board.is-dragging,
      .board.is-dragging .print__link {
        cursor: grabbing;
      }

      .board__reg {
        position: absolute;
        width: 0.9rem;
        height: 0.9rem;
        background:
          linear-gradient(var(--fg) 0 0) center / 100% 1px no-repeat,
          linear-gradient(var(--fg) 0 0) center / 1px 100% no-repeat;
        opacity: 0.38;
        pointer-events: none;
      }

      .board__reg--tl {
        top: 0.9rem;
        left: 0.9rem;
      }

      .board__reg--tr {
        top: 0.9rem;
        right: 0.9rem;
      }

      .board__reg--bl {
        bottom: 0.9rem;
        left: 0.9rem;
      }

      .board__reg--br {
        right: 0.9rem;
        bottom: 0.9rem;
      }

      .print {
        position: absolute;
        top: var(--y);
        left: var(--x);
        z-index: 2;
        width: var(--w);
        margin: 0;
        transform: translate3d(var(--dx, 0px), var(--dy, 0px)) rotate(var(--rot));
        transition: transform 0.32s var(--ease-out);
        cursor: grab;
        touch-action: pan-y pinch-zoom;
        user-select: none;
      }

      .print.is-dragging {
        z-index: 6;
        cursor: grabbing;
        transition: none;
      }

      .print__tape {
        position: absolute;
        top: -0.65rem;
        left: 50%;
        z-index: 3;
        width: clamp(2.6rem, 34%, 5rem);
        height: 1.25rem;
        border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
        background: color-mix(in srgb, var(--accent) 26%, var(--panel));
        box-shadow: 0 1px 0 color-mix(in srgb, var(--fg) 16%, transparent);
        opacity: 0.9;
        transform: translateX(-50%) rotate(-2.4deg);
        pointer-events: none;
      }

      .print__link {
        position: relative;
        display: block;
        overflow: hidden;
        aspect-ratio: var(--print-ratio);
        border: 3px solid var(--fg);
        background: var(--bg);
        box-shadow: 6px 6px 0 var(--fg);
        cursor: grab;
        transition: box-shadow 0.25s var(--ease-out);
      }

      .print__link:hover,
      .print__link:focus-visible {
        box-shadow: 9px 9px 0 var(--accent);
      }

      .print__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.15) contrast(1.02);
        pointer-events: none;
        transition: filter 0.35s var(--ease-out);
      }

      .print__link:hover .print__image {
        filter: grayscale(0) contrast(1.03);
      }

      .print .shot__number {
        font-size: clamp(1.8rem, 3.2vw, 3.2rem);
        -webkit-text-stroke-width: 1px;
      }

      .print__caption {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
        min-width: 0;
        margin-top: 0.5rem;
        padding-top: 0.35rem;
        border-top: 1px solid var(--line);
      }

      .print__no {
        color: var(--accent-text);
      }

      .print__caption-text {
        min-width: 0;
        overflow: hidden;
        color: var(--fg-2);
        font-size: var(--fs-label);
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .board__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        margin-top: 1.4rem;
      }

      .board__hint {
        color: var(--fg-3);
      }

      .gallery__reset {
        padding: 0.55rem 0.9rem;
        border: 2px solid var(--fg);
        background: transparent;
        color: var(--fg);
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: 0.12em;
        line-height: 1;
        text-transform: uppercase;
        transition:
          background-color 0.2s var(--ease-out),
          color 0.2s var(--ease-out);
      }

      .gallery__reset:hover {
        background: var(--fg);
        color: var(--bg);
      }

      .gallery__scroller {
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        padding-block: 0.5rem 1.5rem;
        outline-offset: 4px;
      }

      .gallery__scroller::-webkit-scrollbar {
        display: none;
      }

      .gallery__scroller.is-dragging {
        cursor: grabbing;
        scroll-snap-type: none;
      }

      .gallery__track {
        display: flex;
        align-items: flex-start;
        gap: clamp(1rem, 2.5vw, 2.5rem);
        width: max-content;
        padding-right: var(--gutter);
      }

      .shot {
        width: clamp(17rem, 29vw, 30rem);
        scroll-snap-align: start;
        transform: rotate(calc((var(--shot-i) - 1.5) * 0.7deg));
        transition: transform 0.35s var(--ease-out);
      }

      .shot--offset {
        margin-top: clamp(1.5rem, 4vw, 3.5rem);
      }

      .shot:hover {
        transform: rotate(0);
      }

      .shot__figure {
        margin: 0;
      }

      .shot__link {
        position: relative;
        display: block;
        aspect-ratio: var(--shot-ratio);
        overflow: hidden;
        border: 3px solid var(--fg);
        background: var(--panel);
        box-shadow: 8px 8px 0 var(--accent);
      }

      .shot__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.2) contrast(1.02);
        transition:
          transform 0.7s var(--ease-expo),
          filter 0.35s var(--ease-out);
      }

      .shot__link:hover .shot__image {
        transform: scale(1.04);
        filter: grayscale(0) contrast(1.03);
      }

      .shot__number {
        position: absolute;
        top: -0.08em;
        left: -0.04em;
        z-index: 2;
        font-size: clamp(2.5rem, 4.5vw, 4.5rem);
        line-height: 0.8;
        color: var(--bg);
        -webkit-text-stroke: 2px var(--fg);
        pointer-events: none;
      }

      .shot__hint {
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 2;
        padding: 0.45rem 0.6rem;
        background: var(--accent);
        color: var(--on-accent);
        transform: translateY(100%);
        transition: transform 0.25s var(--ease-out);
      }

      .shot__link:hover .shot__hint,
      .shot__link:focus-visible .shot__hint {
        transform: none;
      }

      .shot__corner {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        width: 1.2rem;
        height: 1.2rem;
        border-top: 2px solid var(--accent);
        border-right: 2px solid var(--accent);
        mix-blend-mode: difference;
      }

      .shot__caption {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        margin-top: 0.8rem;
        padding-top: 0.4rem;
        border-top: 1px solid var(--line);
      }

      .shot__caption-no {
        color: var(--accent-text);
      }

      .shot__caption-text {
        color: var(--fg-2);
        font-size: var(--fs-small);
        line-height: 1.4;
      }

      .gallery__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 2rem;
        margin-top: 1.2rem;
      }

      .gallery__progress {
        position: relative;
        flex: 1 1 18rem;
        height: 3px;
        background: var(--line);
        overflow: hidden;
      }

      .gallery__progress span {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--accent);
        transform: scaleX(0.04);
        transform-origin: left center;
      }

      .gallery__hint {
        color: var(--fg-3);
      }

      @media (max-width: 63.99rem) {
        .board {
          aspect-ratio: auto;
          min-height: 34rem;
        }

        .print {
          top: var(--y-sm);
          left: var(--x-sm);
          width: min(var(--w-sm), 17rem);
        }
      }

      @media (max-width: 47.99rem) {
        .gallery__head {
          align-items: flex-start;
        }

        .gallery__controls {
          width: 100%;
          align-items: stretch;
        }

        .gallery__modes {
          align-self: flex-start;
        }

        .gallery__meta {
          width: 100%;
          justify-content: space-between;
        }

        .shot {
          width: 78vw;
          transform: none;
        }

        .shot--offset {
          margin-top: 0;
        }

        .gallery__scroller {
          margin-right: calc(var(--gutter) * -1);
        }

        .gallery__track {
          padding-right: var(--gutter);
        }

        .gallery__button {
          width: 2.75rem;
          height: 2.75rem;
        }

        .gallery__foot {
          flex-direction: column;
          align-items: stretch;
        }
      }
  }
</style>
